@using System.Globalization
@using WhatToCook.Web.Components.Shared

<article class="planner-meal-card @(Compact ? "planner-meal-card-compact" : "planner-meal-card-expanded")">
    @if (!Compact)
    {
        @if (!string.IsNullOrWhiteSpace(PhotoPath))
        {
            <img src="@RecipeImageUrlBuilder.Build(PhotoPath)" alt="" />
        }
        else
        {
            <span class="planner-recipe-placeholder" aria-hidden="true">♨</span>
        }
    }
    <div class="planner-meal-copy">
        <strong title="@Title">@Title</strong>
        <span>@Multiplier.ToString("0.###", CultureInfo.InvariantCulture) × porcja</span>
    </div>
    <div class="planner-meal-actions @(ActionsOpen ? "planner-meal-actions-active" : string.Empty)">
        <button type="button"
                class="planner-meal-menu-toggle"
                aria-label="Opcje posiłku @Title"
                aria-expanded="@ActionsOpen.ToString().ToLowerInvariant()"
                disabled="@Disabled"
                @onclick="OnToggleActions">
            •••
        </button>
        @if (ActionsOpen)
        {
            <div class="planner-meal-actions-panel">
                <button type="button" aria-label="Zmniejsz mnożnik @Title" disabled="@Disabled" @onclick="OnDecrease">−</button>
                <button type="button" aria-label="Zwiększ mnożnik @Title" disabled="@Disabled" @onclick="OnIncrease">+</button>
                <button type="button" aria-label="Usuń @Title" disabled="@Disabled" @onclick="OnRemove">×</button>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public decimal Multiplier { get; set; }

    [Parameter]
    public string? PhotoPath { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool ActionsOpen { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnToggleActions { get; set; }

    [Parameter]
    public EventCallback OnDecrease { get; set; }

    [Parameter]
    public EventCallback OnIncrease { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }
}
