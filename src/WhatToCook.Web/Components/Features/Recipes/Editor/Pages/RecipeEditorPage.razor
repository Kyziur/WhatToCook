@page "/recipes/new"
@page "/recipes/{RecipeId:guid}/edit"
@using Microsoft.AspNetCore.Components.Web
@using WhatToCook.Web.Components.Shared

<PageTitle>@(RecipeId.HasValue ? "Edytuj przepis" : "Dodaj przepis") | WhatToCook</PageTitle>

<NavigationLock ConfirmExternalNavigation="HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<section class="screen editor-screen">
    <header class="surface-card page-header editor-header">
        <h1 class="screen-title">Edytor przepisu</h1>
        <p class="screen-subtitle">Wypełnij kolejne sekcje i zapisz gotowy przepis.</p>
    </header>


    @if (IsLoading)
    {
        <section class="surface-card">
            <p class="muted">Ładowanie przepisu...</p>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
        {
            <div
                @ref="FeedbackElement"
                class="surface-card @(FeedbackIsError ? "inline-warning" : "inline-message")"
                tabindex="-1"
                role="@(FeedbackIsError ? "alert" : "status")"
                aria-live="@(FeedbackIsError ? "assertive" : "polite")">
                @FeedbackMessage
            </div>
        }

        @if (ServerValidationErrors.Count > 0)
        {
            <section @ref="ValidationSummaryElement" class="surface-card inline-warning" role="alert" tabindex="-1">
                <h3>Nie można zapisać przepisu</h3>
                <ul>
                    @foreach (var error in ServerValidationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </section>
        }

        <EditForm EditContext="EditContext" FormName="recipe-editor" OnSubmit="@(_ => SaveRecipeAsync())">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset class="editor-form-fields" disabled="@(!IsInteractive || IsSaving)">

            <details id="editor-basics" class="surface-card section-card editor-anchor-section" open>
                <summary class="section-title"><span class="section-badge">1</span>Podstawy</summary>
                <div>
                <p class="muted">Nadaj przepisowi nazwę i określ liczbę porcji.</p>
                <div class="field-grid">
                    <div class="field">
                        <label for="recipe-title">Tytuł przepisu</label>
                        <InputText
                            @ref="TitleInput"
                            id="recipe-title"
                            class="input"
                            aria-invalid="@HasFieldError(nameof(Model.Title)).ToString().ToLowerInvariant()"
                            aria-describedby="recipe-title-error"
                            @bind-Value="Model.Title" />
                        <ValidationMessage id="recipe-title-error" For="@(() => Model.Title)" />
                    </div>
                    <div class="field">
                        <label for="recipe-servings">Liczba porcji</label>
                        <InputNumber
                            @ref="ServingsInput"
                            id="recipe-servings"
                            class="input"
                            aria-invalid="@HasFieldError(nameof(Model.Servings)).ToString().ToLowerInvariant()"
                            aria-describedby="recipe-servings-error"
                            @bind-Value="Model.Servings" />
                        <ValidationMessage id="recipe-servings-error" For="@(() => Model.Servings)" />
                    </div>
                </div>
                </div>
            </details>

            <details id="editor-ingredients" class="surface-card section-card editor-anchor-section" open>
                <summary class="section-title"><span class="section-badge">2</span>Składniki</summary>
                <div class="section-head-row">
                    <button type="button" class="chip" @onclick="AddIngredient">Dodaj składnik</button>
                </div>
                <p class="muted">Możesz wybierać z sugestii albo wpisać nowy składnik.</p>
                <div class="list">
                    @foreach (var ingredient in Model.Ingredients.OrderBy(x => x.SortOrder))
                    {
                        <article class="inline-list-row" @key="ingredient.Id">
                            <label class="visually-hidden" for="@GetIngredientNameInputId(ingredient)">
                                Składnik @(ingredient.SortOrder + 1), nazwa
                            </label>
                            <input
                                @ref="ingredient.InputElement"
                                id="@GetIngredientNameInputId(ingredient)"
                                class="input ingredient-name"
                                aria-invalid="@IsFirstIngredientInvalid(ingredient).ToString().ToLowerInvariant()"
                                aria-describedby="@(IsFirstIngredientInvalid(ingredient) ? "ingredients-error" : null)"
                                value="@ingredient.Name"
                                @oninput="args => OnIngredientNameInput(args, ingredient)"
                                list="ingredient-suggestion-list"
                                placeholder="np. pomidor" />
                            <label class="visually-hidden" for="@GetIngredientQuantityInputId(ingredient)">
                                Składnik @(ingredient.SortOrder + 1), ilość
                            </label>
                            <InputText
                                id="@GetIngredientQuantityInputId(ingredient)"
                                class="input ingredient-qty"
                                @bind-Value="ingredient.QuantityText"
                                placeholder="ilość (opcjonalnie)" />
                            <label class="visually-hidden" for="@GetIngredientUnitInputId(ingredient)">
                                Składnik @(ingredient.SortOrder + 1), jednostka
                            </label>
                            <select id="@GetIngredientUnitInputId(ingredient)" class="input ingredient-unit" @bind="ingredient.Unit">
                                @foreach (var unit in AllowedUnits)
                                {
                                    <option value="@unit.Value">@unit.Label</option>
                                }
                            </select>
                            <button type="button" class="chip danger-chip" @onclick="() => RemoveIngredient(ingredient.Id)">Usuń</button>
                        </article>
                    }
                </div>
                <p id="ingredients-error" class="visually-hidden">Dodaj co najmniej jeden składnik.</p>
                <datalist id="ingredient-suggestion-list">
                    @foreach (var suggestion in IngredientSuggestions)
                    {
                        <option value="@suggestion"></option>
                    }
                </datalist>
            </details>

            <details id="editor-preparation" class="surface-card section-card editor-anchor-section" open>
                <summary class="section-title"><span class="section-badge">3</span>Przygotowanie</summary>
                <div class="section-head-row">
                    <button type="button" class="chip" @onclick="AddStep">Dodaj krok</button>
                </div>
                <p class="muted">Utrzymuj kolejność kroków zgodną z przebiegiem gotowania.</p>
                <h4>Kroki</h4>
                <div class="list">
                    @foreach (var step in Model.Steps.OrderBy(x => x.SortOrder))
                    {
                        <article class="step-row" @key="step.Id">
                            <label class="muted" for="@GetStepInputId(step)">Krok @(step.SortOrder + 1)</label>
                            <InputTextArea
                                @ref="step.Input"
                                id="@GetStepInputId(step)"
                                class="input"
                                aria-invalid="@IsFirstStepInvalid(step).ToString().ToLowerInvariant()"
                                aria-describedby="@(IsFirstStepInvalid(step) ? "steps-error" : null)"
                                @bind-Value="step.Text"
                                rows="3" />
                            <div class="actions-row">
                                <button type="button" class="chip" @onclick="() => MoveStepUp(step.Id)">W górę</button>
                                <button type="button" class="chip" @onclick="() => MoveStepDown(step.Id)">W dół</button>
                                <button type="button" class="chip danger-chip" @onclick="() => RemoveStep(step.Id)">Usuń</button>
                            </div>
                        </article>
                    }
                </div>
                 <p id="steps-error" class="visually-hidden">Dodaj co najmniej jeden krok.</p>
            </details>

            <details id="editor-additional" class="surface-card section-card editor-anchor-section" open>
                <summary class="section-title"><span class="section-badge">4</span>Dodatkowe</summary>
                <div>
                <p class="muted">Tagi, zdjęcie i źródło pomagają uporządkować przepis.</p>
                <div class="editor-subsection">
                <h4>Tagi</h4>
                <div class="inline-tag-editor">
                    <label class="visually-hidden" for="recipe-tag">Nowy tag</label>
                    <input
                        id="recipe-tag"
                        class="input"
                        value="@NewTag"
                        @oninput="OnNewTagInput"
                        @onkeydown="OnNewTagKeyDown"
                        list="tag-suggestion-list"
                        placeholder="np. szybkie" />
                    <button type="button" class="chip" @onclick="AddTag">Dodaj tag</button>
                </div>
                <datalist id="tag-suggestion-list">
                    @foreach (var suggestion in TagSuggestions)
                    {
                        <option value="@suggestion"></option>
                    }
                </datalist>
                @if (FilteredTagSuggestions.Count > 0)
                {
                    <div class="chip-row">
                        @foreach (var suggestion in FilteredTagSuggestions)
                        {
                            <button type="button" class="chip ghost-chip" @onclick="() => AddSuggestedTag(suggestion)">
                                @suggestion
                            </button>
                        }
                    </div>
                }
                @if (Model.Tags.Count > 0)
                {
                    <div class="chip-row">
                        @foreach (var tag in Model.Tags)
                        {
                            <button type="button" class="chip selected-chip" @onclick="() => RemoveTag(tag)">
                                @tag ×
                            </button>
                        }
                    </div>
                }
                </div>
                <div class="editor-subsection">
                <h4>Zdjęcie</h4>
                @if (!string.IsNullOrWhiteSpace(SelectedPhotoPreviewUrl))
                {
                    <img class="recipe-photo-image" src="@SelectedPhotoPreviewUrl" alt="Podgląd wybranego zdjęcia" />
                }
                else if (!string.IsNullOrWhiteSpace(CurrentPhotoPath))
                {
                    <img class="recipe-photo-image" src="@RecipeImageUrlBuilder.Build(CurrentPhotoPath)" alt="Aktualne zdjęcie przepisu" />
                }
                <label class="visually-hidden" for="recipe-photo">Zdjęcie główne przepisu</label>
                <InputFile @ref="PhotoInput" id="recipe-photo" OnChange="HandlePhotoSelected" />
                @if (!string.IsNullOrWhiteSpace(SelectedPhotoName))
                {
                    <p class="muted">Wybrano: @SelectedPhotoName</p>
                }
                </div>
                <div class="editor-subsection">
                <h4>Źródło</h4>
                <p class="muted">Wpisz URL lub dowolny tekst, np. „przepis od babci”.</p>
                <div class="field">
                    <label for="recipe-source">Źródło (opcjonalne)</label>
                    <InputText id="recipe-source" class="input" @bind-Value="Model.Source" />
                </div>
                </div>
                </div>
            </details>

            <div class="editor-actions">
                <span class="planner-dirty-state">@(IsDirty ? "Masz niezapisane zmiany" : "Brak niezapisanych zmian")</span>
                <button
                    type="submit"
                    class="primary-action"
                    data-interactive="@IsInteractive.ToString().ToLowerInvariant()"
                    disabled="@(IsSaving || !IsInteractive)">
                    @(IsSaving ? "Zapisywanie..." : "Zapisz przepis")
                </button>
                <a class="secondary-action" href="@SafeReturnUrl">Anuluj</a>
            </div>
            </fieldset>
        </EditForm>
    }
</section>
