{
  "name": "what-to-cook.web-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "npx prettier --ignore-unknown --write",
    "lint": "ng lint",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "fetch-swagger": "curl -o ./swagger.json https://localhost:7059/swagger/v1/swagger.json",
    "generate-contracts": "npm run fetch-swagger && openapi-generator-cli generate -i swagger.json -g typescript-angular -o src/app/api-contracts --global-property models"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.7",
    "@angular/common": "^18.2.7",
    "@angular/compiler": "^18.2.7",
    "@angular/core": "^18.2.7",
    "@angular/forms": "^18.2.7",
    "@angular/platform-browser": "^18.2.7",
    "@angular/platform-browser-dynamic": "^18.2.7",
    "@angular/router": "^18.2.7",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.9",
    "@angular-devkit/build-angular": "^18.2.7",
    "@angular/cli": "^18.2.7",
    "@angular/compiler-cli": "^18.2.7",
    "@ng-icons/bootstrap-icons": "^29.5.1",
    "@ng-icons/core": "^29.5.1",
    "@ng-icons/heroicons": "^29.5.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/jasmine": "~5.1.4",
    "angular-eslint": "18.3.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.12",
    "eslint": "^9.12.0",
    "jasmine-core": "~5.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-firefox-launcher": "^2.1.3",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.8.0"
  }
}
