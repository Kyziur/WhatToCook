DATA_ROOT=/srv/whattocook

# Non-secret deployment settings.
POSTGRES_DB=whattocook
POSTGRES_USER=whattocook
ASPNETCORE_ENVIRONMENT=Production
SEED_DATA_ENABLED=false

# Supplied at deployment time from Bitwarden Secrets Manager.
# The BWS wrapper must inject POSTGRES_PASSWORD before Compose starts.
# POSTGRES_PASSWORD=

# Raspberry Pi 4/5 64-bit.
DOCKER_PLATFORM=linux/arm64/v8
