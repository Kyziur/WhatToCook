{
  "editor.fontFamily": "JetBrains Mono, Cascadia Code, Fira Mono, MesloLGS NF, Noto Color Emoji, monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.foldingImportsByDefault": true,
  "editor.cursorBlinking": "expand",
  "editor.mouseWheelZoom": true,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.stickyScroll.enabled": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.codeLens": false,
  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "csharp.inlayHints.enableInlayHintsForTypes": true,
  "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
  "files.autoSave": "onFocusChange",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.git/index.lock": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/.angular/cache/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": true,
    "**/.angular/cache": true,
    "**/dist": true,
    "**/coverage": true
  },
  "workbench.colorTheme": "Visual Studio Dark",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.activityBar.autoHide": false,
  "workbench.activityBar.compact": false,
  "workbench.sideBar.location": "left",
  "workbench.tree.indent": 8,
  "workbench.view.alwaysShowHeaderActions": false,
  "workbench.editor.alwaysShowEditorActions": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.showTabIndex": false,
  "workbench.editor.sharedViewState": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 12,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.sortOrder": "default",
  "breadcrumbs.enabled": true,
  "breadcrumbs.symbolPath": "on",
  "diffEditor.codeLens": false,
  "diffEditor.experimental.useTrueInlineView": false,
  "dotnet.defaultSolution": "",
  "dotnet.formatting.organizeImportsOnFormat": true,
  "dotnet.projectsystem.enableLanguageServiceCache": true,
  "dotnet.projectsystem.useNewMemoryOptimization": true,
  "dotnet.preferVisualStudioCodeFileSystemWatcher": true,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyleInactive": "outline",
  "terminal.integrated.enableImages": false,
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.smoothScrolling": false,
  "editor.smoothScrolling": false,
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false
}
